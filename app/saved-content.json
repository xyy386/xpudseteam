  "directions": [
    {
      "slug": "ai-pde",
      "title": "人工智能融合的微分方程数值方法",
      "english": "AI + NUMERICAL PDE",
      "image": "/research-fluid.png",
      "equation": "∂ₜu + (u · ∇)u = −∇p + νΔu",
      "summary": "探索人工智能方法与微分方程数值计算的结合，关注复杂方程的高效求解与可靠性。",
      "topics": [
        {
          "title": "智能数值求解",
          "detail": "研究学习方法与传统离散算法的结合方式，用于提升复杂方程求解的效率。",
          "image": "/research-fluid.png"
        },
        {
          "title": "数据与物理约束",
          "detail": "将观测数据、方程结构和边界条件共同纳入建模与计算流程。",
          "image": "/research-fluid.png"
        },
        {
          "title": "误差与泛化",
          "detail": "关注数值精度、稳定性及模型在不同参数条件下的适用范围。",
          "image": "/research-fluid.png"
        }
      ],
      "papers": [
