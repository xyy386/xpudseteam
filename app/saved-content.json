    {
      "slug": "dynamical-data-science",
      "title": "动力系统驱动的数据科学",
      "english": "DYNAMICAL DATA SCIENCE",
      "image": "/research-flow-matching.png",
      "equation": "∂ₜpₜ + ∇ · (pₜvₜ) = 0",
      "summary": "以动力系统理论理解时间数据中的结构，研究预测、状态重建与不确定性。",
      "topics": [
        {
          "title": "时序结构",
          "detail": "分析系统状态随时间的变化，识别周期、突变及其他动力学特征。",
          "image": "/research-flow-matching.png"
        },
        {
          "title": "数据驱动预测",
          "detail": "结合动力学模型与数据方法，对复杂系统未来状态进行推断。",
          "image": "/research-flow-matching.png"
        },
        {
          "title": "随机动力学与生成",
          "detail": "研究随机微分方程、概率流与 flow matching 等方法在时序建模和数据生成中的可能应用。",
          "image": "/research-flow-matching.png"
        }
      ],
